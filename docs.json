{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Bettter",
  "description": "Documentation for Bettter — feature board, roadmap, changelog, and support in one lifetime-payment product.",
  "colors": {
    "primary": "#c7ff10",
    "light": "#e8ff8a",
    "dark": "#9acc00"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://bettter.app/"
  },
  "favicon": {
    "light": "/images/fav.svg",
    "dark": "/images/fav_dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://bettter.app/sign-up"
    },
    "links": [
      {
        "label": "Home",
        "href": "https://bettter.app"
      },
      {
        "label": "Contact support",
        "href": "https://bettter.bettter.app/support"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://bettter.app"
    }
  },
  "fonts": {
    "heading": {
      "family": "Outfit",
      "weight": 700
    },
    "body": {
      "family": "Outfit",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "navigation": {
    "pages": [
      "index",
      {
        "group": "1. Getting started",
        "pages": [
          "1.getting-started/1.1-introduction",
          "1.getting-started/1.2-what-is-a-project",
          "1.getting-started/1.3-creating-and-managing-projects",
          "1.getting-started/1.4-dashboard-overview"
        ]
      },
      {
        "group": "2. Manage content",
        "pages": [
          {
            "group": "Feature cards",
            "pages": [
              "2.manage-content/2.1-creating-a-feature",
              "2.manage-content/2.2-editing-a-feature",
              "2.manage-content/2.3-deleting-a-feature",
              "2.manage-content/2.4-feature-statuses",
              "2.manage-content/2.5-voting",
              "2.manage-content/2.6-comments"
            ]
          },
          {
            "group": "Roadmap",
            "pages": [
              "2.manage-content/2.7-moving-cards-with-drag-and-drop"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "2.manage-content/2.8-creating-a-changelog-entry",
              "2.manage-content/2.9-editing-a-changelog-entry",
              "2.manage-content/2.10-deleting-a-changelog-entry"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "2.manage-content/2.11-receiving-support-tickets"
            ]
          }
        ]
      },
      {
        "group": "3. Configure",
        "icon": "folder",
        "pages": [
          "3.configure/3.1-primary-settings",
          "3.configure/3.2-seo",
          "3.configure/3.3-branding",
          "3.configure/3.4-support-settings",
          "3.configure/3.5-controls",
          "3.configure/3.6-custom-domain",
          "3.configure/3.7-widget",
          "3.configure/3.8-email-notifications"
        ]
      },
      {
        "group": "4. Public portal",
        "pages": [
          "4.public-portal/4.1-how-the-public-portal-works",
          "4.public-portal/4.2-what-visitors-can-do",
          "4.public-portal/4.3-signing-in-on-the-portal"
        ]
      }
    ]
  }
}
