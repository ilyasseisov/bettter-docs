{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bettter",
  "colors": {
    "primary": "#A8DB00",
    "light": "#000000",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/fav.svg",
    "dark": "/images/fav_dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "uno",
        "icon": "annoyed",
        "pages": [
          "getting-started"
        ]
      },
      {
        "group": "dos",
        "icon": "aperture",
        "pages": [
          "seo"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_light.svg",
    "dark": "/images/logo.svg",
    "href": "https://bettter.app/"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact support",
        "href": "https://bettter.bettter.app/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "background": {
    "color": {
      "light": "#fcfcfc",
      "dark": "#606060"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Outfit",
      "weight": 700
    },
    "body": {
      "family": "Outfit",
      "weight": 400
    }
  },
  "thumbnails": {
    "background": "/images/og_home.png"
  },
  "description": "Bettter - feature board, roadmap, changelog and support. Build better products with instant feedback from your users.",
  "styling": {
    "eyebrows": "section"
  }
}
