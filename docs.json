{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bettter",
  "colors": {
    "primary": "#c7ff10",
    "light": "#c7ff10",
    "dark": "#a8db00"
  },
  "favicon": {
    "light": "/images/fav.svg",
    "dark": "/images/fav_dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_light.svg",
    "dark": "/images/logo.svg",
    "href": "https://bettter.app/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://bettter.bettter.app/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "background": {
    "color": {
      "light": "#fcfcfc",
      "dark": "#f3f3f3"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "family": "Outfit",
    "weight": 400
  },
  "thumbnails": {
    "background": "/images/og_home.png"
  },
  "description": "Bettter - feature board, roadmap, changelog and support. Build better products with instant feedback from your users."
}
